# ========================================================================
# EAGLE EYE SECURITY — environment variables (template, no real values)
# Copy to .env.local for local development. Never commit .env.local.
# On Vercel, set the same names under Project Settings -> Environment Variables.
# ========================================================================

# --- Public (bundled into the browser; protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>
# Guards sign in with a username; "sipho" becomes sipho@<this domain>.
NEXT_PUBLIC_GUARD_LOGIN_DOMAIN=guards.eagleeye.local
# Optional. Leave UNSET on Vercel: the build then derives a version from the commit,
# which is what makes phones show "Update available" after each deploy.
# NEXT_PUBLIC_APP_VERSION=

# --- Server only (NEVER prefix with NEXT_PUBLIC_, never commit) ---
# Used only by /api/admin/users (admin creates staff accounts) and scripts/bootstrap-admin.ts.
# Use the NEW key after rotating the leaked one (see docs/DEPLOYMENT.md step 0).
SUPABASE_SERVICE_ROLE_KEY=<server-only-secret-key>

# --- scripts/bootstrap-admin.ts only (run once, locally; see the script header) ---
# BOOTSTRAP_ORG_NAME=
# BOOTSTRAP_SITE_NAME=
# BOOTSTRAP_SITE_CODE=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_ROLE=
# BOOTSTRAP_CONFIRM=
# BOOTSTRAP_ALLOW_EXISTING_ORGS=
